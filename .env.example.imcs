# ============================================================
# IMCS 环境变量模板（可安全提交，不含任何真实密钥）
# ============================================================
# 用法：cp .env.example .env  然后按需修改
# 注意：.env 已被 .gitignore 忽略，切勿提交真实 Key 与密码
#
# 变量名一律使用 app/core/config.py 中 Settings 字段的大写形式
# （pydantic-settings 默认大小写不敏感匹配）。
# ============================================================


# ==================== LLM 供应商 ====================
# 两个供应商共用 openai SDK：DashScope 提供 OpenAI 兼容端点，
# 切换只需改 base_url 与 api_key，代码无需变动。
# 主供应商失败时按 llm_fallback_provider 降级（见下方）。

# OpenAI
OPENAI_API_KEY=请填写你的OpenAI_API_Key
# 仅在使用代理或第三方兼容接口时填写，通常以 /v1 结尾
# OPENAI_BASE_URL=https://你的接口地址/v1

# DashScope（阿里云百炼）。作为国内备用供应商，主供应商超时时接管
DASHSCOPE_API_KEY=请填写你的DashScope_API_Key
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 主备供应商顺序。生产环境建议 primary=dashscope（国内延迟更低、更稳定）
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=dashscope

# ---------- 场景 -> 模型 ----------
# 分诊与对话用轻量模型（高频、要求低延迟），报告解读用强模型（低频、要求准确）
LLM_MODEL_CHAT=gpt-4.1-mini
LLM_MODEL_CHAT_FALLBACK=qwen-turbo
LLM_MODEL_TRIAGE=gpt-4.1-mini
LLM_MODEL_TRIAGE_FALLBACK=qwen-turbo
LLM_MODEL_INTERPRET=gpt-4.1
LLM_MODEL_INTERPRET_FALLBACK=qwen-plus

# Embedding 模型。⚠️ 改这个必须同步改 EMBEDDING_DIM，并执行全量向量重建：
# 不同模型产出的向量不在同一语义空间，混用会让检索结果完全失真
EMBEDDING_MODEL=text-embedding-3-small
# text-embedding-3-small 输出 1536 维，与 vector_embeddings.embedding 列定义绑定
EMBEDDING_DIM=1536
RERANK_MODEL=gte-rerank

# ---------- 单价（美元 / 1K token），用于成本核算 ----------
LLM_PRICE_INPUT_PER_1K=0.0004
LLM_PRICE_OUTPUT_PER_1K=0.0016
EMBEDDING_PRICE_PER_1K=0.00002

# ---------- 超时与重试 ----------
LLM_CONNECT_TIMEOUT=5.0
LLM_READ_TIMEOUT=30.0
# 流式：首 token 慢通常代表供应商排队过载，应快速降级；
# chunk 间隔慢可能只是长文本生成中，不该误杀
LLM_STREAM_FIRST_TOKEN_TIMEOUT=10.0
LLM_STREAM_IDLE_TIMEOUT=15.0
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE=1.0
LLM_RETRY_BACKOFF_CAP=30.0
# 医疗问答要求稳定可复现，温度固定 0
LLM_TEMPERATURE=0.0

# ---------- Token 预算 ----------
# 请求级上限按场景设置，避免单次调用吃掉过多上下文
TOKEN_BUDGET_TRIAGE=2000
TOKEN_BUDGET_REPORT_INTERPRET=8000
TOKEN_BUDGET_CHAT=1500
TOKEN_BUDGET_DEFAULT=4000
# 日配额（超限后降级到小模型，不直接拒绝服务）
TOKEN_DAILY_LIMIT_PER_USER=200000
TOKEN_DAILY_LIMIT_GLOBAL=5000000
# tiktoken 不可用时的兜底估算：中文 1 token ≈ 1.5 字符
TOKEN_CHAR_RATIO_FALLBACK=1.5

# ---------- 调用日志批量落库 ----------
# 同步写库会拖慢流式响应，改为内存缓冲 + 定时/定量刷盘
LLM_LOG_BATCH_SIZE=50
LLM_LOG_FLUSH_INTERVAL=5.0


# ==================== RAG 检索 ====================
# 向量与关键词各召回 20 条，RRF 融合后取前 5 条送 LLM
RAG_VECTOR_FETCH_COUNT=20
RAG_KEYWORD_FETCH_COUNT=20
# RRF 平滑常数，论文推荐 60。调小会放大头部结果权重，调大则趋于平均
RAG_RRF_K=60
RAG_RESULT_COUNT=5
RAG_MIN_SCORE=0.0
# 中文递归分块：700 字符、120 重叠。沿用旧项目已验证的取值
CHUNK_SIZE=700
CHUNK_OVERLAP=120


# ==================== 数据库 ====================
# ⚠️ 这两项在 docker-compose.imcs.yml 里被显式覆盖为容器内网地址，
# 此处填写的值仅用于**在宿主机上直接跑 alembic / pytest / 种子脚本**的场景。
# 宿主机连接走映射端口 5433（本机 5432 已被另一个 PostgreSQL 项目占用）。
DATABASE_URL=postgresql+psycopg://imcs:imcs_password@localhost:5433/imcs
SYNC_DATABASE_URL=postgresql+psycopg://imcs:imcs_password@localhost:5433/imcs

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
# 排查 SQL 时临时打开，生产环境务必为 false（日志量极大且会泄露健康数据）
DB_ECHO=false

# PostgreSQL 容器初始化。首次建卷时生效，改这里不会重置已有数据卷
IMCS_POSTGRES_PASSWORD=imcs_password
IMCS_POSTGRES_HOST_PORT=5433


# ==================== Redis ====================
REDIS_URL=redis://localhost:6380/0
IMCS_REDIS_HOST_PORT=6380
# broker 与 result backend 分库，避免任务队列键和结果键互相干扰
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1


# ==================== 认证 ====================
# ⚠️ 生产环境必须改成强随机值。JWT 密钥泄露等于任何人都能伪造医生身份
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
IMCS_JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=7
# 连续失败 5 次锁定 15 分钟
MAX_LOGIN_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=30


# ==================== Celery ====================
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_EXPIRES=3600
CELERY_WORKER_CONCURRENCY=4


# ==================== 应用 ====================
APP_NAME=IMCS
APP_VERSION=1.0.0
# development / production。生产环境会自动关闭 /docs 并收紧错误详情
IMCS_ENVIRONMENT=development
IMCS_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8010
IMCS_API_HOST_PORT=8010
# API 进程数。CPU 核数少时设为 1，避免与 Celery worker 抢资源
IMCS_API_WORKERS=2

# Flower 监控面板（--profile monitoring）与 Nginx 入口
IMCS_FLOWER_HOST_PORT=5556
IMCS_NGINX_HOST_PORT=8080


# ==================== 构建期代理（可选）====================
# Docker 构建时拉不到 pip 包才需要设置，端口填代理软件当前显示的端口，
# 不要写死旧端口。scripts/docker-manage.sh 会把 WSL 本机代理地址
# 转换为容器可访问的 host.docker.internal 地址。
# DOCKER_HTTP_PROXY=http://host.docker.internal:7890
# DOCKER_HTTPS_PROXY=http://host.docker.internal:7890
